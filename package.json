{
  "name": "express-automated-testing",
  "version": "1.0.0",
  "description": "Express API with Jest and Supertest automated test suite",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --detectOpenHandles --forceExit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check:all": "npm run lint && npm run format:check && npm run test:ci"
  },
  "keywords": [
    "express",
    "jest",
    "supertest",
    "ci",
    "automated-tests"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "supertest": "^7.0.0"
  }
}
